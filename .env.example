# =============================================================================
# MJ Nexus — 環境変数のテンプレート
#   cp .env.example .env.local して値を設定する（.env.local は Git に含めない）
# =============================================================================

# --- フロントエンド（ブラウザに公開される値。VITE_ で始まるもの） -----------------
# Supabase ダッシュボード > Project Settings > API
VITE_SUPABASE_URL=
# anon（または publishable）キーのみ。service_role / secret キーは絶対に入れない
# （誤って入れた場合、アプリは起動時に拒否して「設定エラー」と表示します）
VITE_SUPABASE_ANON_KEY=

# --- サーバー側（ここには書かない。参考として記載） ------------------------------
# SUPABASE_SERVICE_ROLE_KEY は Edge Function 実行環境に自動で提供される。
# Python 分析をローカルで実行する場合のみ、analytics/.env に読み取り専用の接続情報を置く。
